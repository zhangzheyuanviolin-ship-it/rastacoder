# ════════════════════════════════════════════════════════
# Bakertreet Labs — Environment Variables Template
# Copy to .env and fill in your values. NEVER commit .env
# ════════════════════════════════════════════════════════

# ─── NVIDIA NIM (AI Inference) ───────────────────────────
# Get your key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/bakertreet
REDIS_URL=redis://localhost:6379

# ─── Authentication ──────────────────────────────────────
JWT_SECRET=change-me-use-openssl-rand-hex-32
SESSION_SECRET=change-me-use-openssl-rand-hex-32

# ─── GitHub (if using GitHub API) ────────────────────────
# Use fine-grained PATs scoped to minimum permissions
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# ─── Vector Database (RAG) ───────────────────────────────
PINECONE_API_KEY=
WEAVIATE_URL=http://localhost:8080
QDRANT_URL=http://localhost:6333

# ─── Observability ───────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info

# ─── App Config ──────────────────────────────────────────
APP_ENV=development
PORT=8080
DEBUG=false
